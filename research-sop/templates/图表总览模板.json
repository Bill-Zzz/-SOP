  "build": {
    "pathA_copyMaster": [
      "Drive 复制母版 `_母版_图表总览` → 按存储规范改名 `研究对象_历史数据_YYYYMMDD_V1.0`",
      "复制后立即重新执行 lock1（行高）与 lock3（保护范围），不依赖复制是否保留",
      "把语义页数据贴进 数据页（或转换后的 openpyxl 语义页整页复制进来），按内容改页名；在 图表计算 查找替换 `数据页` → 新页名",
      "改首页：A1 代码、E3 使用说明、各块标题、开关标签文字与颜色、口径说明、来源行；按真实业务数改开关数（删多余开关行的勾选框与标签，不删行）",
      "不用的槽位：删除该槽位全部行（图随行删除）；后续槽位自动上移，公式引用不受影响",
      "删完不用的槽位后执行 lock5（删页尾以下多余行）"
    ],
    "pathB_api": [
      "spreadsheets.create：三张表（图表总览 / 数据页 / 图表计算），取 sheetId",
      "断言 hardGuarantees.invariant；不满足则中止",
      "batchUpdate：updateSheetProperties（网格线、冻结、标签色）；updateDimensionProperties（列宽、行高）",
      "batchUpdate：首页 header 单元格与样式（repeatCell）；mergeCells",
      "batchUpdate：每个槽位——块标题、勾选框 setDataValidation(BOOLEAN)、标签值与颜色、说明与来源合并区",
