      "style": "note10"
    },
    "sections": {
      "rule": "首页按时间口径分区，每区以 D 槽（分区标题带）开头；同一区内的图用同一组控件。顺序固定：年度 → 季度 → 单期与事件 → 市值（局部年份）。新图按口径归入对应区的末尾，不混放。",
      "list": [
        {
          "id": "Y",
          "title": "年度 · 随页顶起始、结束年份更新",
          "control": "页顶 A3/C3"
        },
        {
          "id": "Q",
          "title": "季度 · 近 12 个季度，用本区起始季、结束季",
          "control": "本区 C 槽：起始季 / 结束季（下拉引用 图表计算!$B$4:$B$60 季度清单）"
        },
        {
          "id": "E",
          "title": "单期与事件 · 不受年份控制",
          "control": "无年份控件；事件图可有币种下拉"
        },
        {
          "id": "M",
          "title": "市值 · 用本区起始、结束年份与显示数据",
          "control": "本区 C 槽：起始年份 / 结束年份 / 显示数据"
        }
      ]
    },
    "hardGuarantees": {
      "invariant": "每个槽位：rows*24 - chart.heightPx >= 24；双宽 24*24-540=36，单宽 18*24-384=48。建图前由脚本断言，不满足即中止。",
      "lock1_explicitRowHeights": {
        "request": "updateDimensionProperties",
        "range": {
          "sheetId": "{OVERVIEW_ID}",
          "dimension": "ROWS",
          "startIndex": 0,
          "endIndex": 170
        },
        "properties": {
          "pixelSize": 24
        },
        "fields": "pixelSize",
        "note": "第 1 行单独设 32。显式 pixelSize 后 Google 不再按内容自动调行高；说明文字超出只裁剪不撑高。"
      },
      "lock2_chartAnchorFromSlotTable": {
        "rule": "addChart 的 anchorCell.rowIndex = slot.startRow-1，columnIndex 固定 2（左）或 10（右），offsetX/Y = 0；坐标只能由 slots 表算出，脚本不接受手填坐标。",
        "widthHeight": "widthPixels/heightPixels 只能取 1180×540 或 590×384 两档。"
      },
      "lock3_protectSheet": {
        "request": "addProtectedRange",
        "protectedRange": {
          "range": {
            "sheetId": "{OVERVIEW_ID}"
          },
          "description": "图表总览结构锁：不得增删行列、隐藏行、拖动图表；只放开控件单元格",
          "warningOnly": false,
          "editors": {
            "users": [
              "{OWNER_EMAIL}"
            ]
          },
          "unprotectedRanges": [
            "页顶 A3, C3",
            "每个槽位的 toggleRows（A 列或 I 列）",
            "每个 C 槽的控件格 A{r+1}, C{r+1}, E{r+1}"
          ]
        },
        "note": "受保护后非所有者只能改勾选框和下拉；所有者改结构时先临时解除。"
      },
      "lock4_labelWidthAssert": {
        "rule": "每条 B 列标签估算宽度 ≤ 344 px（B 列 360 − 16），估算 = 全角×13.5 + 半角×7；超宽即中止并提示改用简称表",
        "maps_to": "Excel规范 2.4"
      },
      "lock5_rowTrim": {
        "rule": "建完删除页尾以下所有行",
        "request": "deleteDimension ROWS startIndex=<页尾行> endIndex=<rowCount>"
      }
    },
    "rowCountRule": "首页 rowCount = 页尾行 + 1（默认 166），多余行 deleteDimension 删除"
  },
