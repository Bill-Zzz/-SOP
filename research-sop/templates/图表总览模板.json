    "formulaTemplates": {
      "period": "=IFERROR(FILTER({DATA}!$A$4:$A$200,{DATA}!$B$4:$B$200=\"全年\",VALUE({DATA}!$A$4:$A$200)>={START},VALUE({DATA}!$A$4:$A$200)<={END}),\"\")",
      "series": "=IF({TOGGLE},IFERROR(FILTER(IF(ISNUMBER({DATA}!{COL}$4:{COL}$200),{DATA}!{COL}$4:{COL}$200,\"\"),{DATA}!$B$4:$B$200=\"全年\",VALUE({DATA}!$A$4:$A$200)>={START},VALUE({DATA}!$A$4:$A$200)<={END}),\"\"),\"\")",
      "seriesWindow": "=IF({TOGGLE},IFERROR(FILTER(IF((VALUE({DATA}!$A$4:$A$200)>={WIN_START})*(VALUE({DATA}!$A$4:$A$200)<={WIN_END})*ISNUMBER({DATA}!{COL}$4:{COL}$200),{DATA}!{COL}$4:{COL}$200,\"\"),{DATA}!$B$4:$B$200=\"全年\",VALUE({DATA}!$A$4:$A$200)>={START},VALUE({DATA}!$A$4:$A$200)<={END}),\"\"),\"\")",
      "seriesShowData": "=IF(AND({TOGGLE},{SHOW}<>\"{EXCLUDE}\"),IFERROR(FILTER(IF(ISNUMBER({DATA}!{COL}$4:{COL}$200),{DATA}!{COL}$4:{COL}$200,\"\"),VALUE({DATA}!$A$4:$A$200)>={START},VALUE({DATA}!$A$4:$A$200)<={END}),\"\"),\"\")",
      "metricHeader": "=IFERROR(VLOOKUP({METRIC_CELL},$CK$2:$CN$30,2,FALSE),{METRIC_CELL})",
      "metricSeries": "=IF({TOGGLE},IFERROR(FILTER(IF(ISNUMBER(INDEX({DATA}!$D$4:$AZ$200,0,MATCH({HEADER_CELL}&\"（亿美元）\",{DATA}!$D$3:$AZ$3,0))),INDEX({DATA}!$D$4:$AZ$200,0,MATCH({HEADER_CELL}&\"（亿美元）\",{DATA}!$D$3:$AZ$3,0)),\"\"),{DATA}!$B$4:$B$200=\"全年\",VALUE({DATA}!$A$4:$A$200)>={START},VALUE({DATA}!$A$4:$A$200)<={END}),\"\"),\"\")",
      "filterAware": "=IF(SUBTOTAL(103,{DATA}!A{ROW})=0,\"\",{DATA}!{COL}{ROW})",
      "categoryPeriod": "={DATA}!$A${ROW}",
      "categorySeries": "=IF({TOGGLE},IF(ISNUMBER({DATA}!{COL}${ROW}),{DATA}!{COL}${ROW},\"\"),\"\")",
      "label": "=\"● \"&REGEXREPLACE(图表计算!{HEADER_CELL},\"[（(].*[）)]\",\"\")",
      "quarterPeriod": "=IFERROR(FILTER({QDATA}!$A$4:$A$60,MATCH({QDATA}!$A$4:$A$60,$B$4:$B$60,0)>=MATCH({QSTART},$B$4:$B$60,0),MATCH({QDATA}!$A$4:$A$60,$B$4:$B$60,0)<=MATCH({QEND},$B$4:$B$60,0)),\"\")",
      "quarterSeries": "=IF({TOGGLE},IFERROR(FILTER(IF(ISNUMBER({QDATA}!{COL}$4:{COL}$60),{QDATA}!{COL}$4:{COL}$60,\"\"),MATCH({QDATA}!$A$4:$A$60,$B$4:$B$60,0)>=MATCH({QSTART},$B$4:$B$60,0),MATCH({QDATA}!$A$4:$A$60,$B$4:$B$60,0)<=MATCH({QEND},$B$4:$B$60,0)),\"\"),\"\")",
      "sentinelWrap": "=LET(r,<原公式去掉等号>,IF(COUNT(r)=0,0,r))  —— 每个系列列必须包；防止 Google 删除空系列导致配色前移"
    },
    "defaults": {
      "START": "图表总览!$A$3",
      "END": "图表总览!$C$3"
    },
    "quarterList": {
      "cell": "B3",
      "header": "季度清单",
      "formula": "={QDATA}!$A$4:$A$15",
      "range": "B4:B60",
      "note": "{QDATA} = 近12季度明细 语义页，A 列季度文本如 2025Q3，按时间升序"
    }
  },
